# Copia este fichero a .env.local y rellena los valores.
# .env.local esta en .gitignore y nunca se sube al repositorio.

# ---------------------------------------------------------------------------
# Obligatorias
# ---------------------------------------------------------------------------

# Token del bot. Se saca hablando con @BotFather en Telegram: /newbot
TELEGRAM_TOKEN=

# API key de Claude. Se saca en https://console.anthropic.com
# Acuerdate de cargar credito en la cuenta o el bot no podra responder.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------

# En local apunta al directorio del proyecto. En Railway se deja sin tocar
# porque el volume se monta en /app/data.
RUTA_DATOS=./data

# Tu chat id de Telegram. Si lo rellenas, tu eres el administrador fijo y
# nadie mas puede quedarse con el bot escribiendo el primero.
# Para saber el tuyo, habla con @userinfobot.
OWNER_CHAT_ID=

# Tope de gasto mensual en dolares. Al 80% avisa, al 100% deja de responder.
LIMITE_MENSUAL_USD=20

# Preguntas maximas por persona y hora.
LIMITE_PREGUNTAS_HORA=20

# Duracion de la cache de documentos. 1h es lo recomendado.
CACHE_TTL=1h

# Opcional: si la rellenas, el bot transcribe las notas de voz.
# Si la dejas vacia, responde amablemente que de momento solo texto e imagenes.
OPENAI_API_KEY=
